# =============================================================================
# ScanWaste Backend - Production Environment Variables Template
# Copy this file to .env.production on the server and populate secrets:
#   cp .env.production.example .env.production
# Generate random secrets via:
#   openssl rand -hex 32
# =============================================================================

# Server runtime
NODE_ENV=production
PORT=5000

# MongoDB URI (Internal docker service or MongoDB Atlas replica set)
MONGODB_URI=mongodb://mongodb:27017/waste_classification
# Alternatively for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/waste_classification?retryWrites=true&w=majority

# JWT Authentication (REQUIRED: generate with openssl rand -hex 32)
JWT_SECRET=generate_strong_random_jwt_secret_here
JWT_EXPIRES_IN=15m

# Redis Configuration (Internal docker service or managed Redis)
REDIS_URL=redis://redis:6379
REDIS_PREFIX=scanwaste:
REFRESH_TTL_SECONDS=604800

# OTP Secret (REQUIRED: independent random secret)
OTP_SECRET=generate_strong_random_otp_secret_here
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60

# File Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# AI Inference Microservice
AI_SERVICE_URL=http://ai-inference:5005
AI_PROVIDER=fastapi_tflite
INFERENCE_TIMEOUT_MS=5000

# Google OAuth (Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=
SOCIAL_PUBLIC_ORIGIN=https://scanwaste.app

# SMTP Email Service (e.g. SendGrid / Resend / Amazon SES / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@scanwaste.app
SMTP_PASS=app_specific_password_here
SMTP_FROM=no-reply@scanwaste.app
