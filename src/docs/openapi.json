{
  "openapi": "3.0.3",
  "info": {
    "title": "ScanWaste Backend API",
    "version": "1.0.0",
    "description": "Production REST API documentation for ScanWaste - AI-Powered Waste Classification & Dataset Lifecycle Management System.",
    "contact": {
      "name": "ScanWaste Engineering Team",
      "email": "dev@scanwaste.vn"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    },
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    },
    {
      "url": "http://10.0.2.2:5000",
      "description": "Android Emulator Access to Localhost"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter JWT Bearer token obtained from /api/auth/login"
      }
    },
    "schemas": {
      "AuthTokens": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer"
          },
          "refreshExpiresIn": {
            "type": "integer"
          },
          "tokenType": {
            "type": "string"
          }
        }
      },
      "StandardResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operation completed successfully"
          },
          "data": {
            "type": "object"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "example": []
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Invalid request or authorization failed"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Specific validation error"
            ]
          }
        }
      },
      "PredictionItem": {
        "type": "object",
        "properties": {
          "class": {
            "type": "string",
            "example": "plastic"
          },
          "classVi": {
            "type": "string",
            "example": "Nhựa"
          },
          "score": {
            "type": "number",
            "example": 0.942
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Rotate refresh token",
        "security": [],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or OTP"
          },
          "401": {
            "description": "Invalid/expired/revoked token"
          },
          "429": {
            "description": "Rate limit or OTP cooldown"
          },
          "503": {
            "description": "Redis or SMTP unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refreshToken"
                ],
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "description": "Single use, absolute session expiry. Reuse of a consumed refresh token revokes that session. Serialize refresh requests in the client."
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Revoke current session",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or OTP"
          },
          "401": {
            "description": "Invalid/expired/revoked token"
          },
          "429": {
            "description": "Rate limit or OTP cooldown"
          },
          "503": {
            "description": "Redis or SMTP unavailable"
          }
        }
      }
    },
    "/api/auth/logout-all": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Revoke all sessions",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or OTP"
          },
          "401": {
            "description": "Invalid/expired/revoked token"
          },
          "429": {
            "description": "Rate limit or OTP cooldown"
          },
          "503": {
            "description": "Redis or SMTP unavailable"
          }
        }
      }
    },
    "/api/auth/email/send-otp": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Send email verification OTP",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or OTP"
          },
          "401": {
            "description": "Invalid/expired/revoked token"
          },
          "429": {
            "description": "Rate limit or OTP cooldown"
          },
          "503": {
            "description": "Redis or SMTP unavailable"
          }
        }
      }
    },
    "/api/auth/email/verify": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Verify email OTP",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or OTP"
          },
          "401": {
            "description": "Invalid/expired/revoked token"
          },
          "429": {
            "description": "Rate limit or OTP cooldown"
          },
          "503": {
            "description": "Redis or SMTP unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "otp"
                ],
                "properties": {
                  "otp": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/password/forgot": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Request password reset (generic response)",
        "security": [],
        "responses": {
          "202": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or OTP"
          },
          "401": {
            "description": "Invalid/expired/revoked token"
          },
          "429": {
            "description": "Rate limit or OTP cooldown"
          },
          "503": {
            "description": "Redis or SMTP unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/password/reset": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Reset password and revoke all sessions",
        "security": [],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input or OTP"
          },
          "401": {
            "description": "Invalid/expired/revoked token"
          },
          "429": {
            "description": "Rate limit or OTP cooldown"
          },
          "503": {
            "description": "Redis or SMTP unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "otp",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "otp": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health Check",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Backend and database health status",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Backend is running",
                  "data": {
                    "database": "connected"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/health": {
      "get": {
        "summary": "AI Inference Engine Health Check",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "TFLite inference service readiness",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "AI health status retrieved successfully",
                  "data": {
                    "status": "healthy",
                    "ready": true,
                    "model_version": "v3",
                    "engine": "LiteRT/TFLite"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "description": "Starts email registration. Stores pending data and password hash in Redis for 5 minutes. Does not create a MongoDB user or session. Complete with /api/auth/register/verify using the emailed OTP.",
        "summary": "Send registration OTP (account not yet created)",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "phone",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Nguyen Van A"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@scanwaste.vn"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 8,
                    "example": "Password123!"
                  },
                  "phone": {
                    "type": "string",
                    "example": "0912345678"
                  },
                  "confirmPassword": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "OTP accepted by SMTP; awaiting verification",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "registrationId": "<opaque-id>",
                    "email": "user@example.com",
                    "status": "pending_verification",
                    "expiresIn": 300,
                    "resendAfter": 60
                  }
                }
              }
            }
          },
          "409": {
            "description": "Email or phone already registered"
          },
          "429": {
            "description": "Cooldown or rate limit exceeded"
          },
          "503": {
            "description": "Email or authentication store unavailable; account not created"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "Email/phone + password returns 202 with loginChallengeId and no tokens. Confirm via /api/auth/login/verify to obtain the session. Google login retains its verified-provider flow.",
        "summary": "Validate password and send login OTP",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@scanwaste.vn"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "Password123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Password valid; OTP sent, no session yet",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "loginChallengeId": "<opaque-id>",
                    "email": "user@example.com",
                    "status": "pending_otp",
                    "expiresIn": 300,
                    "resendAfter": 60
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          },
          "429": {
            "description": "Rate limit or OTP cooldown"
          },
          "503": {
            "description": "SMTP or Redis unavailable"
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "tags": [
          "Users"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile retrieved",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Get profile successfully",
                  "data": {
                    "id": "670c1...",
                    "name": "Nguyen Van A",
                    "email": "user@scanwaste.vn",
                    "role": "user"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/ai/classify": {
      "post": {
        "summary": "Classify waste image using real MobileNetV2 AI engine",
        "tags": [
          "AI Classification"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "image"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG/PNG/WEBP image <= 5MB"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Classification completed successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "AI classification successfully",
                  "data": {
                    "classificationId": "670c2f...",
                    "imageUrl": "/uploads/waste-1726500000000.jpg",
                    "predictedClass": "plastic",
                    "predictedClassVi": "Nhựa",
                    "confidence": 0.952,
                    "topPredictions": [
                      {
                        "class": "plastic",
                        "classVi": "Nhựa",
                        "score": 0.952
                      },
                      {
                        "class": "glass",
                        "classVi": "Thủy tinh",
                        "score": 0.024
                      },
                      {
                        "class": "metal",
                        "classVi": "Kim loại",
                        "score": 0.012
                      },
                      {
                        "class": "paper",
                        "classVi": "Giấy",
                        "score": 0.005
                      },
                      {
                        "class": "cardboard",
                        "classVi": "Bìa carton",
                        "score": 0.004
                      },
                      {
                        "class": "organic",
                        "classVi": "Rác hữu cơ",
                        "score": 0.002
                      },
                      {
                        "class": "other",
                        "classVi": "Khác",
                        "score": 0.001
                      }
                    ],
                    "disposalTips": [
                      "Làm sạch và làm rỗng chai/hộp nhựa trước khi bỏ rác.",
                      "Bỏ nắp chai riêng nếu nắp làm bằng chất liệu khác.",
                      "Phân loại vào thùng rác tái chế màu trắng/vàng."
                    ],
                    "modelVersion": "v3",
                    "source": "server",
                    "inferenceTimeMs": 28.5
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid image or magic bytes mismatch"
          },
          "413": {
            "description": "File exceeds 5MB size limit"
          }
        }
      }
    },
    "/api/ai/sync": {
      "post": {
        "summary": "Synchronize offline classifications made on Mobile",
        "tags": [
          "AI Offline Sync"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "clientClassificationId",
                        "predictedClass",
                        "confidence"
                      ],
                      "properties": {
                        "clientClassificationId": {
                          "type": "string",
                          "example": "offline_uuid_12345"
                        },
                        "predictedClass": {
                          "type": "string",
                          "enum": [
                            "organic",
                            "cardboard",
                            "glass",
                            "metal",
                            "paper",
                            "plastic",
                            "other"
                          ],
                          "example": "plastic"
                        },
                        "confidence": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1,
                          "example": 0.88
                        },
                        "offlineTimestamp": {
                          "type": "string",
                          "format": "date-time",
                          "example": "2026-10-27T10:00:00.000Z"
                        },
                        "modelVersion": {
                          "type": "string",
                          "example": "v3-mobile"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synchronization summary with deduplication",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Synchronized 1 items successfully (0 duplicate skipped)",
                  "data": {
                    "syncedCount": 1,
                    "duplicateCount": 0,
                    "results": [
                      {
                        "clientClassificationId": "offline_uuid_12345",
                        "status": "synced",
                        "classificationId": "670c..."
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/ai/feedback": {
      "post": {
        "summary": "Submit user feedback on misclassified items",
        "tags": [
          "AI Feedback"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "classificationId",
                  "correctClass"
                ],
                "properties": {
                  "classificationId": {
                    "type": "string",
                    "example": "670c2f..."
                  },
                  "correctClass": {
                    "type": "string",
                    "enum": [
                      "organic",
                      "cardboard",
                      "glass",
                      "metal",
                      "paper",
                      "plastic",
                      "other"
                    ],
                    "example": "glass"
                  },
                  "comment": {
                    "type": "string",
                    "example": "Chai thủy tinh trong suốt nhưng AI dự đoán nhầm thành nhựa"
                  },
                  "consentGiven": {
                    "type": "boolean",
                    "default": true,
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Feedback submitted successfully",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Feedback submitted successfully. Thank you for helping improve ScanWaste AI!",
                  "data": {
                    "id": "670c...",
                    "status": "pending",
                    "predictedClass": "plastic",
                    "correctClass": "glass",
                    "isCorrect": false
                  }
                }
              }
            }
          }
        }
      }
    },
