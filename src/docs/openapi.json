    "/api/auth/register/verify": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Create account after OTP verification",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "registrationId",
                  "otp"
                ],
                "properties": {
                  "registrationId": {
                    "type": "string",
                    "description": "Opaque ID returned by register, kept in memory by the client"
                  },
                  "otp": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Verified account created; returns user, token, refreshToken, expiresIn, refreshExpiresIn and tokenType"
          },
          "400": {
            "description": "Wrong/expired/consumed OTP or registration ID"
          },
          "409": {
            "description": "Email or phone already taken"
          },
          "429": {
            "description": "Rate limit or resend cooldown"
          },
          "503": {
            "description": "Email/store unavailable"
          }
        }
      }
    },
    "/api/auth/register/resend": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Resend registration OTP",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "registrationId"
                ],
                "properties": {
                  "registrationId": {
                    "type": "string",
                    "description": "Opaque ID returned by register, kept in memory by the client"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP resent"
          },
          "400": {
            "description": "Wrong/expired/consumed OTP or registration ID"
          },
          "409": {
            "description": "Email or phone already taken"
          },
          "429": {
            "description": "Rate limit or resend cooldown"
          },
          "503": {
            "description": "Email/store unavailable"
          }
        }
      }
    },
