          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "deprecated"
              ]
            }
          },
          {
            "name": "targetPlatform",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "server",
                "mobile_bundled",
                "universal"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Models list with pagination and active counts"
          },
          "403": {
            "description": "Forbidden - Admin required"
          }
        }
      },
      "post": {
        "summary": "Register a new AI model version (Admin only)",
        "tags": [
          "Admin AI Management"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "modelName",
                  "version",
                  "artifactPath"
                ],
                "properties": {
                  "modelName": {
                    "type": "string",
                    "example": "ScanWaste MobileNetV2 V4"
                  },
                  "version": {
                    "type": "string",
                    "example": "v4"
                  },
                  "artifactPath": {
                    "type": "string",
                    "example": "models/scanwaste_mobilenetv2_v4.tflite"
                  },
                  "checksum": {
                    "type": "string",
                    "example": "e87cf8c2..."
                  },
                  "inputShape": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "default": [
                      1,
                      224,
                      224,
                      3
                    ]
                  },
                  "outputShape": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "default": [
                      1,
                      7
                    ]
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "targetPlatform": {
                    "type": "string",
                    "enum": [
                      "server",
                      "mobile_bundled",
                      "universal"
                    ],
                    "default": "server"
                  },
                  "trainingAccuracy": {
                    "type": "number",
                    "nullable": true,
                    "example": 0.942
                  },
                  "validationAccuracy": {
                    "type": "number",
                    "nullable": true,
                    "example": 0.915
                  },
                  "testAccuracy": {
                    "type": "number",
                    "nullable": true,
                    "default": null
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Model version registered successfully with inactive status"
          },
          "400": {
            "description": "Invalid metadata, incompatible tensor shapes, or checksum mismatch"
          },
          "409": {
            "description": "Version already exists"
          }
        }
      }
    },
