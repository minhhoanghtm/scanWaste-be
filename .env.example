PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/waste_classification

JWT_SECRET=waste_classification_secret_key_2026_super_secure
JWT_EXPIRES_IN=15m

MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Google Identity Services: public Web application client ID, not a secret.
GOOGLE_CLIENT_ID=
SOCIAL_PUBLIC_ORIGIN=http://localhost:5173
# AI Inference Service
AI_SERVICE_URL=http://127.0.0.1:5005
AI_PROVIDER=fastapi_tflite
INFERENCE_TIMEOUT_MS=5000

# Redis is required; no in-memory fallback for authentication.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=scanwaste:
REFRESH_TTL_SECONDS=604800
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_SECRET=replace-with-an-independent-random-secret
# SMTP (587 STARTTLS or 465 with SMTP_SECURE=true)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
